def param(parent, label, defaults, unit=""):
    box = tk.Frame(parent, bg=BG_PANEL, padx=8, pady=6)
    box.pack(fill="x", pady=3)
    hdr = tk.Frame(box, bg=BG_PANEL)
    hdr.pack(fill="x")
    tk.Label(hdr, text=label, font=FONT_HEADING, fg=CREAM, bg=BG_PANEL, anchor="w").pack(side="left")
    if unit:
        tk.Label(hdr, text=unit, font=FONT_SMALL, fg=TEXT_GRAY, bg=BG_PANEL).pack(side="right")
    row = tk.Frame(box, bg=BG_PANEL)
    row.pack(fill="x", pady=2)
    entries = []
    for lbl, val in zip(["Min", "Mode", "Max"], defaults):
        col = tk.Frame(row, bg=BG_PANEL)
        col.pack(side="left", expand=True, fill="x", padx=2)
        tk.Label(col, text=lbl, font=FONT_SMALL, fg=TEXT_GRAY, bg=BG_PANEL).pack()
        e = tk.Entry(col, bg=BG_ENTRY, fg=ACCENT_LIGHT, justify="center",
                     font=FONT_MONO, insertbackground=ACCENT_PINK, relief="flat", bd=3, width=7)
        e.insert(0, str(val))
        e.pack(fill="x")
        entries.append(e)
    return entries

