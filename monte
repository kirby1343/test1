def build_system_prompt(data):
    """Build a rich system prompt from current simulation results."""
    if not data:
        return (
            "No simulation has been run yet. Ask the user to run the Monte Carlo simulation first."
        )
    return f"""AI assistant embedded in a Monte Carlo Reserves Estimator application.

Monte Carlo simulation with the following results:

SIMULATION RESULTS:
  Iterations run : {data.get('n', 0):,}
  P90 (1C / Conservative)  : {data.get('p90', 0)/1e6:.4f} MMSTB  ({data.get('p90', 0):,.0f} STB)
  P50 (2C / Most Likely)   : {data.get('p50', 0)/1e6:.4f} MMSTB  ({data.get('p50', 0):,.0f} STB)
  P10 (3C / Optimistic)    : {data.get('p10', 0)/1e6:.4f} MMSTB  ({data.get('p10', 0):,.0f} STB)
  Mean (Expected Value)    : {data.get('mean', 0)/1e6:.4f} MMSTB  ({data.get('mean', 0):,.0f} STB)
  Standard Deviation       : {data.get('std', 0)/1e6:.4f} MMSTB
  Minimum                  : {data.get('min', 0)/1e6:.4f} MMSTB
  Maximum                  : {data.get('max', 0)/1e6:.4f} MMSTB
  P5                       : {data.get('p5', 0)/1e6:.4f} MMSTB
  P25                      : {data.get('p25', 0)/1e6:.4f} MMSTB
  P75                      : {data.get('p75', 0)/1e6:.4f} MMSTB
  P95                      : {data.get('p95', 0)/1e6:.4f} MMSTB

STATISTICAL INDICATORS:
  Coefficient of Variation : {data.get('cv', 0):.2%}
  Skewness                 : {data.get('skewness', 0):.4f}
  Risk Level               : {data.get('risk_level', 'N/A')}
  Confidence               : {data.get('confidence', 'N/A')}

NOTE on exceedance convention:
  P90 = value exceeded by 90% of iterations (conservative floor)
  P50 = value exceeded by 50% of iterations (base case median)
  P10 = value exceeded by 10% of iterations (optimistic upside)
"""

def ask_ai_online(question):
    """Call the online Hermes model and return the reply string."""
    try:
        res = client.chat.completions.create(
            model=AI_MODEL,
            max_tokens=512,
            messages=[
                {"role": "system", "content": build_system_prompt(sim_data)},
                {"role": "user",   "content": question}
            ]
        )
        return res.choices[0].message.content.strip()
    except Exception as e:
        return f"[Connection error: {e}]"

def send_message():
    q = chat_entry.get().strip()
    if not q or q == PLACEHOLDER:
        return

    # Clear input immediately
    chat_entry.delete(0, tk.END)
    chat_entry.config(fg=TEXT_GRAY)
    chat_entry.insert(0, PLACEHOLDER)

    # Disable send while waiting
    send_btn.config(state="disabled", text="...")
    ai_status_lbl.config(text="● THINKING", fg=ORANGE_SOFT)

    insert_chat("user", f"\n▶ You: {q}\n")
    insert_chat("wait", "◆ AI:  thinking...\n")

    def worker():
        reply = ask_ai_online(q)
        # Update UI from main thread
        root.after(0, lambda: finish_reply(reply))

    def finish_reply(reply):
        # Remove the "thinking..." line
        chat_box.config(state="normal")
        chat_box.delete("end-2l", "end-1l")   # delete last inserted line
        chat_box.config(state="disabled")

        insert_chat("ai", f"◆ AI:  {reply}\n")
        send_btn.config(state="normal", text="ASK")
        ai_status_lbl.config(text="● ONLINE", fg=GREEN_SOFT)

    threading.Thread(target=worker, daemon=True).start()

def clear_chat():
    chat_box.config(state="normal")
    chat_box.delete("1.0", tk.END)
    chat_box.config(state="disabled")

send_btn.config(command=send_message)
clear_btn.config(command=clear_chat)
